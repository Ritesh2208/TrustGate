# ============================================================
# OPTIONAL TRUSTGATE RETRAINING
# ============================================================

if len(experiences) >= MIN_EXPERIENCES_FOR_RETRAINING:

    print()
    print("=" * 70)
    print("GENUINE EXPERIENCES FOUND")
    print("=" * 70)

    print(
        "Experiences:",
        len(experiences)
    )

    print(
        "Retraining TrustGate..."
    )

    # --------------------------------------------------------
    # Load human data
    # --------------------------------------------------------

    human_file = (
        "outputs/"
        "trustgate_standardized_500_labeled.json"
    )

    with open(
        human_file,
        "r",
        encoding="utf-8"
    ) as f:

        human_data = json.load(f)

    X_hidden = []
    X_signal = []
    y = []

    for item in human_data:

        hidden = np.asarray(
            item["hidden_state"],
            dtype=np.float32
        )

        X_hidden.append(hidden)

        X_signal.append([
            float(item["confidence"]),
            float(item["entropy"])
        ])

        y.append(
            item["label"]
        )

    # --------------------------------------------------------
    # Add genuine experiences
    # --------------------------------------------------------

    for experience in experiences:

        X_hidden.append(
            np.asarray(
                experience["hidden_state"],
                dtype=np.float32
            )
        )

        X_signal.append([
            experience["new_confidence"],
            experience["new_entropy"]
        ])

        y.append(
            experience["new_label"]
        )

    X_hidden = np.asarray(
        X_hidden,
        dtype=np.float32
    )

    X_signal = np.asarray(
        X_signal,
        dtype=np.float32
    )

    y = np.asarray(
        y
    )

    print(
        "Training examples:",
        len(y)
    )

    # --------------------------------------------------------
    # Train exactly the same 22-D architecture
    # --------------------------------------------------------

    from sklearn.preprocessing import StandardScaler
    from sklearn.decomposition import PCA
    from sklearn.svm import LinearSVC

    hidden_scaler = StandardScaler()

    X_hidden_scaled = (
        hidden_scaler.fit_transform(
            X_hidden
        )
    )

    pca = PCA(
        n_components=20,
        random_state=42
    )

    X_pca = pca.fit_transform(
        X_hidden_scaled
    )

    X_final = np.hstack([
        X_pca,
        X_signal
    ])

    final_scaler = StandardScaler()

    X_final_scaled = (
        final_scaler.fit_transform(
            X_final
        )
    )

    classifier = LinearSVC(
        class_weight="balanced",
        random_state=42,
        max_iter=10000
    )

    classifier.fit(
        X_final_scaled,
        y
    )

    training_predictions = (
        classifier.predict(
            X_final_scaled
        )
    )

    training_accuracy = float(
        np.mean(
            training_predictions == y
        )
    )

    bundle = {
        "hidden_scaler":
            hidden_scaler,
        "pca":
            pca,
        "final_scaler":
            final_scaler,
        "classifier":
            classifier,
        "input_hidden_dimension":
            896,
        "pca_dimension":
            20,
        "final_dimension":
            22,
        "signal_features":
            [
                "confidence",
                "entropy"
            ]
    }

    joblib.dump(
        bundle,
        OUTPUT_MODEL
    )

    summary[
        "self_improved_model_trained"
    ] = True

    summary[
        "self_improved_training_accuracy"
    ] = training_accuracy

    with open(
        OUTPUT_SUMMARY,
        "w",
        encoding="utf-8"
    ) as f:

        json.dump(
            summary,
            f,
            indent=2
        )

    print()
    print(
        "New model saved:",
        OUTPUT_MODEL
    )

    print(
        "Training accuracy:",
        f"{training_accuracy:.4f}"
    )

else:

    summary[
        "self_improved_model_trained"
    ] = False

