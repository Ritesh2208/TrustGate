                )

                break

            evidence_payload = {
                "original_answer":
                    current["answer"],
                "evidence":
                    evidence_text
            }

            # ------------------------------------------------
            # Generate corrected answer
            # ------------------------------------------------

            print(
                "[A1] Generating "
                "evidence-grounded correction..."
            )

            candidate = generate_answer(
                question,
                evidence_payload
            )

            print()
            print("Candidate:")
            print(candidate["answer"])

            new_label = controller.classify(
                candidate["hidden_state"],
                candidate["confidence"],
                candidate["entropy"]
            )

            print(
                "Candidate TrustGate:",
                new_label
            )

            print(
                "Candidate confidence:",
                f"{candidate['confidence']:.4f}"
            )

            print(
                "Candidate entropy:",
                f"{candidate['entropy']:.4f}"
            )

            # ------------------------------------------------
            # Verify candidate
            # ------------------------------------------------

            print()
            print(
                "[VERIFY] Checking candidate..."
            )

            new_verification = verifier.verify(
                question,
                candidate["answer"]
            )

            print(
                "Candidate verification:",
                new_verification[
                    "verification_status"
                ]
            )

            print(
                "Support:",
                f"{new_verification['support_score']:.4f}"
            )

            print(
                "Contradiction:",
                f"{new_verification['contradiction_score']:.4f}"
            )

            # ------------------------------------------------
            # Decision
            # ------------------------------------------------

            decision = evaluate_improvement(
                current,
                candidate,
                old_verification,
                new_verification,
                old_label,
                new_label
            )

            print()
            print(
                "DECISION:",
                decision["decision"]
            )

            print(
                "REASON:",
                decision["reason"]
            )

            attempt_records.append({
                "round": round_index,
                "old_answer":
                    current["answer"],
                "new_answer":
                    candidate["answer"],
                "old_label":
                    old_label,
                "new_label":
                    new_label,
                "old_confidence":
                    current["confidence"],
                "new_confidence":
                    candidate["confidence"],
                "old_entropy":
                    current["entropy"],
                "new_entropy":
                    candidate["entropy"],
                "verification":
                    new_verification,
                "decision":
                    decision
            })

            # ------------------------------------------------
            # ACCEPT
            # ------------------------------------------------

            if decision["decision"] == "ACCEPT":

                print()
                print(
                    ">>> GENUINE IMPROVEMENT ACCEPTED <<<"
                )

                transition = (
                    f"{old_label} -> {new_label}"
