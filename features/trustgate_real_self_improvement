# ============================================================
# GENERATION
# ============================================================

def generate_answer(question, evidence_text=None):
    """
    Generate an answer.

    If evidence is provided, force an evidence-grounded
    correction rather than asking the small model to
    perform unconstrained self-refinement.
    """

    if evidence_text:
        prompt = f"""
You are correcting an answer using factual evidence.

QUESTION:
{question}

ORIGINAL ANSWER:
{evidence_text["original_answer"]}

EVIDENCE:
{evidence_text["evidence"]}

TASK:
Write a corrected answer to the QUESTION using the EVIDENCE.

Rules:
1. Correct any factual error in the original answer.
2. Do not repeat a claim contradicted by the evidence.
3. Do not invent facts not supported by the evidence.
4. Answer the question directly.
5. Be concise.
6. Return only the corrected answer.
"""
    else:
        prompt = f"""
Answer the following question accurately and concisely.

QUESTION:
{question}

Return only the answer.
"""

    messages = [
        {
            "role": "user",
            "content": prompt
        }
    ]

    formatted = tokenizer.apply_chat_template(
        messages,
        tokenize=False,
        add_generation_prompt=True
    )

    inputs = tokenizer(
        formatted,
        return_tensors="pt"
    )

    input_ids = inputs["input_ids"].to(DEVICE)
    attention_mask = inputs["attention_mask"].to(DEVICE)

    input_length = input_ids.shape[1]

    with torch.no_grad():

        generated = model.generate(
            input_ids=input_ids,
            attention_mask=attention_mask,
            max_new_tokens=MAX_NEW_TOKENS,
            do_sample=False,
            temperature=None,
            top_p=None,
            output_scores=True,
            return_dict_in_generate=True
        )

    sequences = generated.sequences

    answer_tokens = sequences[:, input_length:]

    answer = tokenizer.decode(
        answer_tokens[0],
        skip_special_tokens=True
    ).strip()

    # --------------------------------------------------------
    # Confidence and entropy
    # --------------------------------------------------------

    token_confidences = []
    token_entropies = []

    if generated.scores:

        for step, logits in enumerate(generated.scores):

            probs = torch.softmax(
                logits[0].float(),
                dim=-1
            )

            token_id = int(
                answer_tokens[0, step].item()
            )

            confidence = float(
                probs[token_id].item()
            )

            entropy = float(
                -(probs * torch.log(
                    probs.clamp_min(1e-12)
                )).sum().item()
            )

            token_confidences.append(confidence)
            token_entropies.append(entropy)

    confidence = (
        float(np.mean(token_confidences))
        if token_confidences
        else 0.0
    )

    entropy = (
        float(np.mean(token_entropies))
        if token_entropies
        else 0.0
    )

    # --------------------------------------------------------
    # Full-sequence hidden representation
    # --------------------------------------------------------

    full_attention_mask = torch.ones_like(
        sequences
    )

    with torch.no_grad():

        outputs = model(
            input_ids=sequences,
            attention_mask=full_attention_mask,
            output_hidden_states=True
        )

    final_hidden = outputs.hidden_states[-1]

    generated_hidden = final_hidden[
        0,
        input_length:,
        :
    ]

    if generated_hidden.shape[0] == 0:
        raise RuntimeError(
            "No generated hidden states found."
        )

    hidden_state = (
        generated_hidden
        .mean(dim=0)
        .detach()
        .float()
        .cpu()
        .numpy()
        .astype(np.float32)
    )

    if hidden_state.shape[0] != 896:
        raise RuntimeError(
            f"Expected 896-D hidden state, "
            f"got {hidden_state.shape[0]}"
        )

    return {
        "answer": answer,
        "hidden_state": hidden_state,
        "confidence": confidence,
        "entropy": entropy
    }


# ============================================================
# TEXT SIMILARITY
# ============================================================

def normalize_text(text):
    text = str(text).lower()
    text = re.sub(r"\s+", " ", text)
    text = re.sub(r"[^a-z0-9 ]", "", text)
    return text.strip()


def token_jaccard(a, b):

    a_tokens = set(
        normalize_text(a).split()
    )

    b_tokens = set(
        normalize_text(b).split()
    )

    if not a_tokens and not b_tokens:
        return 1.0

    if not a_tokens or not b_tokens:
        return 0.0

    return len(a_tokens & b_tokens) / len(
        a_tokens | b_tokens
    )


def answer_changed(old_answer, new_answer):

    similarity = token_jaccard(
        old_answer,
        new_answer
    )

    return similarity < 0.90


# ============================================================
# EVIDENCE TEXT
# ============================================================

def build_evidence_text(verification):

    records = []

    for source in verification.get(
        "sources",
        []
    ):

        title = source.get(
            "title",
            "Unknown source"
        )

        for sentence in source.get(
            "sentences",
            []
        ):

            records.append(
                f"[{title}] {sentence}"
            )

    # Keep prompt compact.
    return "\n".join(
        records[:8]
    )


# ============================================================
# EVIDENCE QUALITY
# ============================================================

def evidence_supports_answer(verification):

    status = verification.get(
        "verification_status"
    )

    support = float(
        verification.get(
            "support_score",
            0.0
        )
    )

    contradiction = float(
        verification.get(
            "contradiction_score",
            0.0
        )
    )

    source_count = int(
        verification.get(
            "source_count",
            0
        )
    )

    evidence_count = int(
        verification.get(
            "evidence_sentence_count",
            0
        )
    )

    return (
        status == "SUPPORTED"
        and source_count >= 1
        and evidence_count >= 1
        and support > contradiction
    )


# ============================================================
# IMPROVEMENT DECISION
# ============================================================

def evaluate_improvement(
    old,
    new,
    old_verification,
    new_verification,
    old_label,
    new_label
):

    # --------------------------------------------------------
    # Candidate must actually change
    # --------------------------------------------------------

    if not answer_changed(
        old["answer"],
        new["answer"]
    ):

        return {
            "decision": "ROLLBACK",
            "reason": "ANSWER_UNCHANGED"
        }

    # --------------------------------------------------------
    # Candidate cannot be externally contradicted
    # --------------------------------------------------------

    if new_verification.get(
        "verification_status"
    ) == "CONTRADICTED":

        return {
            "decision": "ROLLBACK",
            "reason": "CANDIDATE_EXTERNALLY_CONTRADICTED"
        }

    # --------------------------------------------------------
    # Evidence must support candidate
    # --------------------------------------------------------

    candidate_supported = (
        evidence_supports_answer(
            new_verification
        )
    )

    if not candidate_supported:

        return {
            "decision": "ROLLBACK",
            "reason": "CANDIDATE_NOT_EVIDENCE_SUPPORTED"
        }

    old_priority = controller.trust_priority(
        old_label
    )

    new_priority = controller.trust_priority(
        new_label
    )

    # --------------------------------------------------------
    # Genuine improvement:
    # Trust class improves AND evidence supports candidate
    # --------------------------------------------------------

    if new_priority > old_priority:

        return {
            "decision": "ACCEPT",
            "reason": "GENUINE_TRUST_CLASS_IMPROVEMENT"
        }

    # --------------------------------------------------------
    # Same class:
    # require BOTH confidence improvement and entropy reduction
    # --------------------------------------------------------

    if (
        new_label == old_label
        and
        new["confidence"] > old["confidence"]
        and
        new["entropy"] < old["entropy"]
    ):

        return {
            "decision": "ACCEPT",
            "reason": "GENUINE_SIGNAL_IMPROVEMENT"
        }

    return {
        "decision": "ROLLBACK",
        "reason": "NO_TRUST_IMPROVEMENT"
    }


