                        new_verification,
                    "decision":
                        decision,
                    "timestamp":
                        time.time()
                })

                accepted = True
                current = candidate
                old_label = new_label
                old_verification = new_verification

                break

            # ------------------------------------------------
            # ROLLBACK
            # ------------------------------------------------

            else:

                print(
                    ">>> CANDIDATE REJECTED <<<"
                )

                break

        results.append({
            "question": question,
            "initial_answer":
